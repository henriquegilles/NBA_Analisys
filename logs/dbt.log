  create view "nba"."analytics_raw"."stg_players_stats__dbt_tmp"
    
    
  as (
    with src as (
  select * from "nba"."analytics_raw"."players_stats"
)

select
  upper(trim("Player")) as player_name,
  upper(trim("Tm"))     as team,
  upper(trim("Opp"))    as opponent,
  upper(trim("Res"))    as result,

  -- MP pode vir como 'MM:SS' ou como número decimal; trate os dois casos
  coalesce(
    case when "MP"::text ~ '^\d+:\d{1,2}$' then
      split_part("MP"::text, ':', 1)::int
      + split_part("MP"::text, ':', 2)::int / 60.0
    end,
    nullif("MP"::text, '')::double precision
  ) as minutes_played,

  nullif(trim("FG")::text,       '')::int                as field_goals_made,
  nullif(trim("FGA")::text,      '')::int                as field_goals_attempted,
  nullif(trim("FGPer")::text,    '')::double precision   as fg_pct,

  nullif(trim("ThreP")::text,    '')::int                as three_pt_made,
  nullif(trim("ThrePA")::text,   '')::int                as three_pt_attempted,
  nullif(trim("ThrePPer")::text, '')::double precision   as three_pt_pct,

  nullif(trim("FT")::text,       '')::int                as free_throws_made,
  nullif(trim("FTA")::text,      '')::int                as free_throws_attempted,
  nullif(trim("FTPer")::text,    '')::double precision   as ft_pct,

  nullif(trim("ORB")::text, '')::int  as offensive_rebounds,
  nullif(trim("DRB")::text, '')::int  as defensive_rebounds,
  nullif(trim("TRB")::text, '')::int  as total_rebounds,

  nullif(trim("AST")::text, '')::int  as assists,
  nullif(trim("STL")::text, '')::int  as steals,
  nullif(trim("BLK")::text, '')::int  as blocks,
  nullif(trim("TOV")::text, '')::int  as turnovers,
  nullif(trim("PF")::text,  '')::int  as personal_fouls,
  nullif(trim("PTS")::text, '')::int  as points,

  nullif(trim("GmSc")::text, '')::double precision       as game_score,
  to_date(nullif(trim("Data")::text, ''), 'YYYY-MM-DD')  as game_date
from src
  );
