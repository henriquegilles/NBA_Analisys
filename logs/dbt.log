  nullif(trim("FTPer"),'')::double precision   as ft_pct,

  nullif(trim("ORB"), '')::int                 as offensive_rebounds,
  nullif(trim("DRB"), '')::int                 as defensive_rebounds,
  nullif(trim("TRB"), '')::int                 as total_rebounds,

  nullif(trim("AST"), '')::int                 as assists,
