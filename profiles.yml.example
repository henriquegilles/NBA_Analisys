# profiles.yml.example
# Copie este arquivo para ~/.dbt/profiles.yml e preencha as variáveis de ambiente,
# ou use os valores padrão para desenvolvimento local com Docker.
#
# NUNCA commit o profiles.yml real com credenciais.

nba_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host:     "{{ env_var('DBT_HOST', 'localhost') }}"
      port:     "{{ env_var('DBT_PORT', '5432') | int }}"
      dbname:   "{{ env_var('DBT_DBNAME', 'nba') }}"
      user:     "{{ env_var('DBT_USER', 'postgres') }}"
      password: "{{ env_var('DBT_PASSWORD', 'postgres') }}"
      schema:   analytics
      threads:  4
      connect_timeout: 10
