# .env.example — copy to .env and fill in the real values
# .env is in .gitignore and must never be committed

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Used by dbt (via env_var()) and by Docker Compose.
DBT_HOST=localhost
DBT_PORT=5432
DBT_DBNAME=nba
DBT_USER=postgres
DBT_PASSWORD=postgres

# ── Scraping ──────────────────────────────────────────────────────────────────
# Target season (end year — e.g. 2025 = the 2024-25 season)
BBR_SEASON=2026

# ── Dagster ───────────────────────────────────────────────────────────────────
# Directory for Dagster's internal metadata (SQLite for runs, logs)
DAGSTER_HOME=.dagster
