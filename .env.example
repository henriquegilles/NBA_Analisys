# .env.example — copie para .env e preencha os valores reais
# .env está no .gitignore e nunca deve ser commitado

# Conexão PostgreSQL
DBT_HOST=localhost
DBT_PORT=5432
DBT_DBNAME=nba
DBT_USER=postgres
DBT_PASSWORD=postgres

# Temporada alvo do scraping (ex: 2025 = temporada 2024-25)
BBR_SEASON=2025
