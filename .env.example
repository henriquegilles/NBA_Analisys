# .env.example — copie para .env e preencha os valores reais
# .env está no .gitignore e nunca deve ser commitado

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Usadas pelo dbt (via env_var()) e pelo Docker Compose.
DBT_HOST=localhost
DBT_PORT=5432
DBT_DBNAME=nba
DBT_USER=postgres
DBT_PASSWORD=postgres

# ── Scraping ──────────────────────────────────────────────────────────────────
# Temporada alvo (ano de término — ex: 2025 = temporada 2024-25)
BBR_SEASON=2025

# ── Dagster ───────────────────────────────────────────────────────────────────
# Diretório de metadados internos do Dagster (SQLite de runs, logs)
DAGSTER_HOME=.dagster
